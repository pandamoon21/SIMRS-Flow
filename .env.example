# ───────────────────────────────────────────────────────────────
# SIMRS-Flow environment configuration (copy to .env, never commit)
# ───────────────────────────────────────────────────────────────

# --- Orchestrator server ---
# Port the orchestrator HTTP/SSE API listens on
ORCHESTRATOR_PORT=4500
# Host binding. Default 0.0.0.0 = reachable from other LAN PCs; 127.0.0.1 = this PC only.
# (QA_AUTH_TOKEN forces 127.0.0.1 when this is left unset, and refuses an explicit LAN bind.)
ORCHESTRATOR_HOST=0.0.0.0
# Comma-separated allowed CORS origins for the UI
ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173

# --- Authentication ---
# A successful EvoMedis login IS the app login: users sign in with their own
# EvoMedis username/password via the UI (POST /api/auth/login). The orchestrator
# logs into SIMRS on their behalf, holds the credentials in memory only (never
# on disk), and issues a session token that authorizes write actions and binds
# each live run to that user's EvoMedis session. There are no static tokens to
# configure here.
#
# The browser also receives the same opaque session in an HttpOnly, SameSite=Lax
# app cookie for authenticated same-origin reads and EventSource. Set to 1 only
# when the dashboard is served over HTTPS; Secure cookies are not sent over HTTP.
APP_COOKIE_SECURE=0
# (Legacy ORCHESTRATOR_AUTH_TOKENS is no longer used — per-user login replaces it.)

# --- EvoMedis / SIMRS target ---
# Base URL of the EvoMedis/SIMRS v1 instance (no trailing slash).
# Required for live mode. Example: http://<simrs-host>/<evomedis-app>/index.php
EVOMEDIS_BASE_URL=
# Optional v2 JSON API base URL (if the instance exposes one)
EVOMEDIS_BASE_URL_V2=
# Cookie name issued by the backend (CodeIgniter uses ci_session).
EVOMEDIS_SESSION_COOKIE_NAME=ci_session
# Optional shared service-account cookie (fallback for live runs started
# without a per-user login). Leave empty to require per-user login. Provide at
# runtime via env / secret store — NEVER hardcode in source.
EVOMEDIS_SESSION_COOKIE=
# Request timeout in milliseconds
EVOMEDIS_TIMEOUT_MS=30000

# --- Execution mode ---
# Deployment posture only. Current execution mode is selected per run and
# still defaults to preview in code; setting this does not auto-enable writes.
# preview = dry-run only (default, no mutating endpoints fire)
# write   = mutations allowed but still gated by approval
EXECUTION_MODE=preview

# --- Audit ledger ---
# Directory where append-only JSONL run ledgers are written
AUDIT_LEDGER_DIR=./.data/audit
# Rules-page values (versioned rules.json + rules-history.jsonl). Default ./.data/rules
# RULES_DIR=./.data/rules
# Set to 1 to enable verbose (redacted) request/response debug logging
DEBUG_HTTP=0

# --- Controlled live pilot harness (scripts/pilot-live-write.ts) ---
# Explicit scope for the guarded one-patient proof run. Lists accept comma,
# semicolon, or whitespace separators. Leave blank unless running the authorized
# pilot harness; normal UI runs do not use these variables.
PILOT_PATIENT_ALLOWLIST=
PILOT_PATIENT=
PILOT_DATE=
# Must name only non-final/non-critical mutating endpoints that are also safe
# under the workflow allowlist, e.g. kasir.updateTglMasuk for a scoped pilot.
PILOT_MUTATION_ALLOWLIST=
# Required for clipboard mode when no masked TTY prompt is available.
PILOT_USERNAME=
# Optional override; defaults to AUDIT_LEDGER_DIR / ./.data/pilot-live-write.
PILOT_LEDGER_DIR=
# Never store passwords here. The harness rejects password env vars and CLI flags;
# use the masked prompt or the local Windows clipboard mode.

# --- UI (Vite) ---
# Base URL the UI uses to reach the orchestrator API. This value is embedded
# at UI build time; use the host's LAN/HTTPS URL before building for other PCs.
VITE_ORCHESTRATOR_URL=http://localhost:4500
# Optional built UI directory served by the orchestrator. Leave empty to use
# apps/ui/dist. Use only when the production bundle is stored elsewhere.
UI_DIR=
# Iur naik kelas page: the doctors' Google Form responses sheet. Must be
# link-shared; empty = none until an operator sets the link
# under "Pengaturan lanjutan" (saved in NAIK_KELAS_FILE, shared by everyone).
NAIK_KELAS_SHEET_URL=
# Stored snapshot (+ chosen source). Re-read automatically once per
# NAIK_KELAS_REFRESH_HOURS, or on the page's "Ambil sekarang".
NAIK_KELAS_FILE=./.data/naik-kelas.json
NAIK_KELAS_REFRESH_HOURS=24
# Ranap "Cek kelengkapan berkas (OCR)" (opt-in per run): results cached per
# No. RM + tanggal masuk/pulang; OCR runs offline on this host.
BERKAS_CACHE_DIR=./.data/berkas

# Local QA only: enables mock login button/endpoint. Never set in production.
QA_AUTH_TOKEN=
QA_AUTH_OPERATOR=qa-operator
VITE_QA_AUTH=0

# Pilot only: when 1, write runs skip the human gate/plan confirmation and the
# requesting operator is recorded as the approver. Allowlist, preconditions,
# read-after-write verification and the audit ledger all still apply. Leave 0
# outside a supervised pilot — it removes the human confirmation step.
AUTO_APPROVE_WRITES=0
# Approvals a critical gate/plan (verifikasi, tampung bayar) needs: 2 = two
# distinct operators (default), 1 = single-operator site. Each approval is
# still a human click and still audited.
CRITICAL_APPROVALS=2


# ───────────────────────────────────────────────────────────────
# SIMRS-Flow environment configuration
#   1. Copy this file to .env (gitignored; never commit it).
#   2. Fill in the two REQUIRED values below; everything else has a working default.
#   3. Restart the orchestrator (run.bat / npm run dev:orchestrator) after editing.
# Portable build: the same keys live in config.env next to start.bat.
# ───────────────────────────────────────────────────────────────

# ===== REQUIRED for live use ===================================

# EvoMedis/SIMRS v1 entry point: the URL you see in the browser up to and
# including index.php, no trailing slash. Empty = offline/fixture mode only
# (EvoMedis login fails until it is set).
#   Example (LAN IP):   EVOMEDIS_BASE_URL=http://10.0.0.10/evoMedis_rsxyz/index.php
#   Example (hostname): EVOMEDIS_BASE_URL=http://simrs.rsxyz.local/evoMedis/index.php
EVOMEDIS_BASE_URL=

# Iur naik kelas page: the Google Form responses sheet doctors fill in. Paste
# the sheet link as copied from the browser (Share → "Anyone with the link").
# Empty = the page stays empty until an operator sets a link under
# "Pengaturan lanjutan" (saved in NAIK_KELAS_FILE, shared by everyone).
#   Example: NAIK_KELAS_SHEET_URL=https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789/edit?gid=0#gid=0
NAIK_KELAS_SHEET_URL=

# ===== Orchestrator server =====================================

# Port of the API + built UI. Open http://<this-pc-ip>:4500/ from other PCs.
ORCHESTRATOR_PORT=4500
# 0.0.0.0 = reachable from other LAN PCs (default); 127.0.0.1 = this PC only.
# (QA_AUTH_TOKEN forces 127.0.0.1 when this is left unset, and refuses an explicit LAN bind.)
ORCHESTRATOR_HOST=0.0.0.0
# Comma-separated browser origins allowed to call the API. Only matters when the
# UI is served from a different origin than the API (e.g. the Vite dev server).
#   Example: ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173,http://192.168.1.50:4500
ORCHESTRATOR_CORS_ORIGINS=http://localhost:5173

# ===== Authentication ==========================================
# A successful EvoMedis login IS the app login: users sign in with their own
# EvoMedis username/password in the UI. The orchestrator holds credentials in
# memory only (never on disk) and issues a session token that authorizes writes.
# There are no static tokens to configure here.

# 1 only when the dashboard is served over HTTPS (Secure cookies are not sent over HTTP).
APP_COOKIE_SECURE=0

# ===== EvoMedis / SIMRS (advanced) =============================

# Optional v2 JSON API base URL, only if the instance exposes one.
#   Example: EVOMEDIS_BASE_URL_V2=http://10.0.0.10/evoMedis_v2/api
EVOMEDIS_BASE_URL_V2=
# Session cookie name issued by EvoMedis (CodeIgniter default; rarely changed).
EVOMEDIS_SESSION_COOKIE_NAME=ci_session
# Optional shared service-account cookie VALUE (without "ci_session="), used only
# for live runs started without a per-user login. Leave empty to require login.
EVOMEDIS_SESSION_COOKIE=
# Per-request timeout in milliseconds (30000 = 30 s). Raise on a slow SIMRS.
EVOMEDIS_TIMEOUT_MS=30000

# ===== Execution & approvals ===================================

# Deployment posture only; each run still defaults to preview (dry-run).
#   preview = no mutating endpoint ever fires
#   write   = mutations allowed, still gated by approval
EXECUTION_MODE=preview
# Approvals a critical gate/plan (verifikasi, tampung bayar) needs:
#   2 = two distinct operators (default), 1 = single-operator site.
CRITICAL_APPROVALS=2
# Supervised pilot only: 1 skips the human gate/plan click (the requester is
# recorded as approver). Allowlist, preconditions, verification and the audit
# ledger still apply. Keep 0 otherwise.
AUTO_APPROVE_WRITES=0

# ===== Data folders (relative to the repo / app folder) ========

# Append-only JSONL run ledgers (one file per run).
AUDIT_LEDGER_DIR=./.data/audit
# Rules-page values (rules.json + rules-history.jsonl).
RULES_DIR=./.data/rules
# Naik kelas snapshot + chosen sheet; re-read every NAIK_KELAS_REFRESH_HOURS
# hours or on the page's "Ambil sekarang".
NAIK_KELAS_FILE=./.data/naik-kelas.json
NAIK_KELAS_REFRESH_HOURS=24
# Team sticky notes on the Overview page.
NOTES_FILE=./.data/notes.json
# Ranap OCR berkas cache (per No. RM + tanggal masuk/pulang); OCR runs offline.
BERKAS_CACHE_DIR=./.data/berkas
# 1 = verbose (redacted) request/response logging for troubleshooting.
DEBUG_HTTP=0

# ===== UI (Vite) ================================================

# API URL baked into the UI at build time. Leave as-is when the orchestrator
# serves the UI itself (run.bat start / portable); set the host's LAN URL only
# when the UI bundle is hosted elsewhere.
#   Example: VITE_ORCHESTRATOR_URL=http://192.168.1.50:4500
VITE_ORCHESTRATOR_URL=http://localhost:4500
# Built UI directory. Empty = apps/ui/dist.
UI_DIR=

# ===== Local QA only — never set on a production host ==========

# Enables the mock login button/endpoint (any non-empty token, e.g. qa-dev-token).
QA_AUTH_TOKEN=
QA_AUTH_OPERATOR=qa-operator
VITE_QA_AUTH=0
# Credentials for the local live QA scripts (scripts/qa-run-live.mjs). Keep them
# only in your own gitignored .env; leave LIVE_PASS empty to be read from the
# clipboard instead.
LIVE_USER=
LIVE_PASS=

# ===== Controlled live pilot harness (scripts/pilot-live-write.ts) ====
# Leave blank unless running the authorized one-patient pilot. Lists accept
# comma, semicolon or whitespace separators.
#   Example: PILOT_PATIENT=0-12-34-56   PILOT_DATE=2026-10-20
PILOT_PATIENT_ALLOWLIST=
PILOT_PATIENT=
PILOT_DATE=
# Only non-final, non-critical mutating endpoints, e.g. kasir.updateTglMasuk.
PILOT_MUTATION_ALLOWLIST=
# EvoMedis username for the pilot. The pilot never reads passwords from env or
# flags: it asks via a masked prompt or the local Windows clipboard.
PILOT_USERNAME=
# Optional; defaults to AUDIT_LEDGER_DIR or ./.data/pilot-live-write.
PILOT_LEDGER_DIR=

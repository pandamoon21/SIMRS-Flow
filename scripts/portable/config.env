# SIMRS-Flow portable settings (read by start.bat). Edit with Notepad, then restart start.bat.
# Paths are relative to the app\ folder.

# Port and binding. 0.0.0.0 = other LAN PCs can open it; 127.0.0.1 = this PC only.
ORCHESTRATOR_PORT=4500
ORCHESTRATOR_HOST=0.0.0.0

# WAJIB: alamat EvoMedis/SIMRS seperti di browser, sampai index.php, tanpa / di akhir.
#   Contoh: EVOMEDIS_BASE_URL=http://10.0.0.10/evoMedis_rsxyz/index.php
EVOMEDIS_BASE_URL=
EVOMEDIS_TIMEOUT_MS=30000

# Data written by the app (audit ledger, rules, naik kelas, OCR cache).
AUDIT_LEDGER_DIR=./.data/audit
RULES_DIR=./.data/rules
# Link Google Sheet iur naik kelas (Share: "Anyone with the link"). Kosong = diisi operator di halaman.
#   Contoh: NAIK_KELAS_SHEET_URL=https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789/edit?gid=0#gid=0
NAIK_KELAS_SHEET_URL=
NAIK_KELAS_FILE=./.data/naik-kelas.json
BERKAS_CACHE_DIR=./.data/berkas
NOTES_FILE=./.data/notes.json

# Persetujuan gate/rencana kritis: 1 = satu operator (default), 2 = dua operator berbeda.
CRITICAL_APPROVALS=1
# 1 (default) = write disetujui otomatis atas nama operator (precondition & verifikasi tetap jalan); 0 = tunggu klik.
AUTO_APPROVE_WRITES=1
